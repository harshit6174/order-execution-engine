{
  "compilerOptions": {
    /* ===============================
       Project Structure
    =============================== */
    "rootDir": "./src",
    "outDir": "./dist",

    /* ===============================
       Runtime Environment
    =============================== */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],

    /* ===============================
       Node.js Support
    =============================== */
    "types": ["node","jest"],
    "moduleResolution": "node",

    /* ===============================
       Output & Debugging
    =============================== */
    "sourceMap": true,
    "declaration": false,

    /* ===============================
       Type Safety
    =============================== */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* ===============================
       Build Reliability
    =============================== */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "tests"]
}
